discovery.docker "containers" { host = "unix:///var/run/docker.sock" }
discovery.relabel "backend" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "backend"
    action        = "keep"
  }
}
loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.backend.output
  labels     = { service_name = "itda-backend" }
  forward_to = [loki.process.backend.receiver]
}
loki.process "backend" {
  stage.json { expressions = { event_category = "event_category", level = "level", route = "route", tool = "tool", deployment_environment = "deployment_environment" } }
  stage.labels { values = { service_name = "", deployment_environment = "", event_category = "", level = "", route = "", tool = "" } }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" { endpoint { url = "http://loki:3100/loki/api/v1/push" } }
