{
  "title": "ITDA 로그 관제",
  "uid": "itda-log-operations",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "10s",
  "time": {"from": "now-3d", "to": "now"},
  "timepicker": {"time_options": ["15m", "1h", "6h", "24h", "3d", "7d", "30d"]},
  "tags": ["ITDA", "로그", "운영"],
  "templating": {
    "list": [
      {"name": "level", "label": "레벨", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values(level)", "definition": "label_values(level)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}, "refresh": 1},
      {"name": "route", "label": "경로", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values(route)", "definition": "label_values(route)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}, "refresh": 1},
      {"name": "tool", "label": "도구", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values(tool)", "definition": "label_values(tool)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}, "refresh": 1},
      {"name": "category", "label": "분류", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values(event_category)", "definition": "label_values(event_category)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}, "refresh": 1},
      {"name": "outcome", "label": "결과", "type": "custom", "query": "success,failure,skipped,blocked", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}},
      {"name": "request_id", "label": "요청 ID", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}}
    ]
  },
  "panels": [
    {"type": "stat", "title": "오류", "description": "선택 기간의 ERROR·CRITICAL 이벤트 수", "id": 1, "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "red"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}, "targets": [{"expr": "sum(count_over_time({service_name=\"itda-backend\",level=~\"ERROR|CRITICAL\",route=~\"$route\",tool=~\"$tool\",event_category=~\"$category\"}[$__range]))", "queryType": "instant", "refId": "A"}]},
    {"type": "stat", "title": "경고", "description": "선택 기간의 WARNING 이벤트 수", "id": 2, "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "orange"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}, "targets": [{"expr": "sum(count_over_time({service_name=\"itda-backend\",level=\"WARNING\",route=~\"$route\",tool=~\"$tool\",event_category=~\"$category\"}[$__range]))", "queryType": "instant", "refId": "A"}]},
    {"type": "stat", "title": "자기수정 시도", "description": "선택 기간의 자기수정 판단 이벤트 수", "id": 3, "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "blue"}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}, "targets": [{"expr": "sum(count_over_time({service_name=\"itda-backend\",event_category=\"repair\",route=~\"$route\",tool=~\"$tool\"} | json | event_name=\"repair.decision.made\" | __error__=\"\" [$__range]))", "queryType": "instant", "refId": "A"}]},
    {"type": "stat", "title": "최종 실패", "description": "선택 기간에 실패로 종료된 질문 수", "id": 4, "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "dark-red"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "dark-red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}, "targets": [{"expr": "sum(count_over_time({service_name=\"itda-backend\",event_category=\"pipeline\",route=~\"$route\"} | json | event_name=\"query.pipeline.completed\" | outcome=\"failure\" | __error__=\"\" [$__range]))", "queryType": "instant", "refId": "A"}]},
    {"type": "logs", "title": "핵심 로그", "description": "상태 확인 요청을 제외한 구조화 로그입니다. 한 줄을 클릭하면 모든 필드를 볼 수 있습니다.", "id": 5, "gridPos": {"h": 12, "w": 14, "x": 0, "y": 4}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": false, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "exact", "sortOrder": "Descending"}, "targets": [{"expr": "{service_name=\"itda-backend\",level=~\"$level\",route=~\"$route\",tool=~\"$tool\",event_category=~\"$category\"} | json | __error__=\"\" | path!=\"/health\" | path!=\"/internal/metrics\" | path!=\"/internal/demo/metrics\" | outcome=~\"$outcome\" | request_id=~\"$request_id\" | line_format `[{{.level}}] {{if .summary}}{{.summary}}{{else}}{{.event_name}}{{end}} · {{.outcome}}{{if .issue_code}} · {{.issue_code}}{{end}}{{if .duration_ms}} · {{.duration_ms}}ms{{end}}`", "refId": "A"}]},
    {"type": "logs", "title": "실패·차단", "description": "WARNING 이상인 실행 실패와 정책 차단만 표시합니다. INFO 상태 이벤트와 자기수정 판단은 제외됩니다.", "id": 6, "gridPos": {"h": 12, "w": 10, "x": 14, "y": 4}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}, "targets": [{"expr": "{service_name=\"itda-backend\",level=~\"WARNING|ERROR|CRITICAL\",route=~\"$route\",tool=~\"$tool\",event_category=~\"$category\"} | json | __error__=\"\" | event_category!=\"http\" | event_name!=\"repair.decision.made\" | outcome=~\"failure|blocked\" | request_id=~\"$request_id\" | line_format `[{{.level}}] {{if .summary}}{{.summary}}{{else}}{{.event_name}}{{end}}`", "refId": "A"}]},
    {"type": "logs", "title": "최종 실패 상세", "description": "질문 전체 처리가 최종 실패로 끝난 이벤트만 표시합니다. 행을 클릭하면 실패 도구, 상태, 요청 ID를 확인할 수 있습니다.", "id": 10, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}, "targets": [{"expr": "{service_name=\"itda-backend\",event_category=\"pipeline\",route=~\"$route\"} | json | __error__=\"\" | event_name=\"query.pipeline.completed\" | outcome=\"failure\" | request_id=~\"$request_id\" | line_format `[{{.level}}] {{if .summary}}{{.summary}}{{else}}{{.route}} 질문 처리가 최종 실패로 종료됐습니다{{end}}{{if .final_status}} · {{.final_status}}{{end}}`", "refId": "A"}]},
    {"type": "logs", "title": "자기수정 흐름", "description": "실패 판단부터 재시도 성공 또는 소진까지의 흐름입니다.", "id": 7, "gridPos": {"h": 10, "w": 12, "x": 0, "y": 24}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}, "targets": [{"expr": "{service_name=\"itda-backend\",event_category=\"repair\",route=~\"$route\",tool=~\"$tool\"} | json | __error__=\"\" | request_id=~\"$request_id\" | line_format `{{if .summary}}{{.summary}}{{else}}{{.event_name}}{{end}} · {{.decision}}{{if .attempt}} · {{.attempt}}/{{.max_attempts}}{{end}}{{if .issue_code}} · {{.issue_code}}{{end}}`", "refId": "A"}]},
    {"type": "logs", "title": "안전성·관리자 검토", "description": "쿼리 가드 판단과 관리자 검토 변경 이력을 함께 표시합니다.", "id": 8, "gridPos": {"h": 10, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}, "targets": [{"expr": "{service_name=\"itda-backend\",event_category=~\"audit|admin_review\",route=~\"$route\",tool=~\"$tool\"} | json | __error__=\"\" | request_id=~\"$request_id\" | line_format `{{if .summary}}{{.summary}}{{else}}{{.event_name}}{{end}}{{if .decision}} · {{.decision}}{{end}}{{if .status}} · {{.status}}{{end}}{{if .issue_code}} · {{.issue_code}}{{end}}`", "refId": "A"}]},
    {"type": "logs", "title": "요청별 전체 처리 흐름", "description": "상단 요청 ID에 request_id를 입력하면 한 요청의 시작부터 종료까지 추적할 수 있습니다.", "id": 9, "gridPos": {"h": 11, "w": 24, "x": 0, "y": 34}, "datasource": {"type": "loki", "uid": "loki"}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "exact", "sortOrder": "Ascending"}, "targets": [{"expr": "{service_name=\"itda-backend\"} | json | __error__=\"\" | path!=\"/health\" | path!=\"/internal/metrics\" | path!=\"/internal/demo/metrics\" | request_id=~\"$request_id\" | line_format `[{{.level}}] {{if .summary}}{{.summary}}{{else}}{{.event_name}}{{end}} · {{.route}}/{{.tool}} · {{.outcome}}`", "refId": "A"}]}
  ]
}
