    {"type":"stat","title":"선택 기간 입력 토큰","description":"Grafana 우측 상단에서 선택한 기간의 누적 입력 토큰입니다.","id":12,"gridPos":{"h":5,"w":6,"x":0,"y":32},"targets":[{"expr":"sum(increase(itda_model_input_tokens_total[$__range]))","legendFormat":"입력"}]},
    {"type":"stat","title":"선택 기간 캐시 입력·쓰기","description":"Grafana 우측 상단에서 선택한 기간의 캐시 입력 및 캐시 쓰기 토큰입니다.","id":13,"gridPos":{"h":5,"w":6,"x":6,"y":32},"targets":[{"expr":"sum(increase(itda_model_cached_input_tokens_total[$__range]))","legendFormat":"캐시 입력"},{"expr":"sum(increase(itda_model_cache_write_tokens_total[$__range]))","legendFormat":"캐시 쓰기"}]},
