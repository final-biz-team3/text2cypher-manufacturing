    {"type":"timeseries","title":"라우팅·최종 상태별 질문","id":7,"gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"sum by(route, final_status) (rate(itda_chat_requests_total[5m]))","legendFormat":"{{route}} · {{final_status}}"}]},
    {"type":"timeseries","title":"응답시간 p50·p95·p99","id":8,"gridPos":{"h":8,"w":12,"x":12,"y":4},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"expr":"histogram_quantile(0.50, sum by(le) (rate(itda_chat_request_duration_seconds_bucket[5m])))","legendFormat":"p50"},{"expr":"histogram_quantile(0.95, sum by(le) (rate(itda_chat_request_duration_seconds_bucket[5m])))","legendFormat":"p95"},{"expr":"histogram_quantile(0.99, sum by(le) (rate(itda_chat_request_duration_seconds_bucket[5m])))","legendFormat":"p99"}]},
    {"type":"timeseries","title":"SQL·Cypher 실행 결과","id":9,"gridPos":{"h":8,"w":12,"x":0,"y":12},"targets":[{"expr":"sum by(route, tool, outcome) (rate(itda_tool_executions_total[5m]))","legendFormat":"{{route}} · {{tool}} · {{outcome}}"}]},
    {"type":"timeseries","title":"모델·DB p95 지연","id":10,"gridPos":{"h":8,"w":12,"x":12,"y":12},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"expr":"histogram_quantile(0.95, sum by(le, purpose) (rate(itda_model_call_duration_seconds_bucket[5m])))","legendFormat":"모델 · {{purpose}}"},{"expr":"histogram_quantile(0.95, sum by(le, tool) (rate(itda_db_query_duration_seconds_bucket[5m])))","legendFormat":"DB · {{tool}}"}]},
