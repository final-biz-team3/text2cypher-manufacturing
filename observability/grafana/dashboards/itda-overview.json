    {"type":"stat","title":"선택 기간 추정 비용","description":"선택 기간의 모델별 설정 단가 기반 추정 비용이며 실제 청구 금액과 다를 수 있습니다.","id":15,"gridPos":{"h":5,"w":6,"x":18,"y":32},"fieldConfig":{"defaults":{"unit":"currencyUSD","decimals":6},"overrides":[]},"targets":[{"expr":"sum(increase(itda_model_estimated_cost_usd_total[$__range]))","legendFormat":"추정 비용"}]},
    {"type":"timeseries","title":"최근 30일 일별 토큰 사용량","description":"각 시점 직전 24시간의 단계별 토큰 사용량입니다. Prometheus 보존 기간 내 데이터만 표시됩니다.","id":16,"gridPos":{"h":8,"w":12,"x":0,"y":37},"timeFrom":"30d","fieldConfig":{"defaults":{"custom":{"drawStyle":"bars","fillOpacity":70,"stacking":{"mode":"normal","group":"A"}}},"overrides":[]},"targets":[{"expr":"sum by(purpose) (increase(itda_model_input_tokens_total[1d]))","legendFormat":"입력 · {{purpose}}"},{"expr":"sum by(purpose) (increase(itda_model_output_tokens_total[1d]))","legendFormat":"출력 · {{purpose}}"},{"expr":"sum by(purpose) (increase(itda_model_cached_input_tokens_total[1d]))","legendFormat":"캐시 입력 · {{purpose}}"},{"expr":"sum by(purpose) (increase(itda_model_cache_write_tokens_total[1d]))","legendFormat":"캐시 쓰기 · {{purpose}}"}]},
