{
  "title":"ITDA 운영 종합","uid":"itda-overview","schemaVersion":41,"version":4,"refresh":"15s","time":{"from":"now-3d","to":"now"},"timepicker":{"time_options":["1h","6h","24h","3d","7d","30d"]},"tags":["ITDA","운영"],
  "panels":[
    {"type":"stat","title":"백엔드 수집 상태","id":1,"gridPos":{"h":4,"w":4,"x":0,"y":0},"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"중단","color":"red"},"1":{"text":"정상","color":"green"}}}]},"overrides":[]},"targets":[{"expr":"up{job=\"itda-backend\"}","legendFormat":"백엔드"}]},
    {"type":"stat","title":"선택 기간 질문 수","id":2,"gridPos":{"h":4,"w":4,"x":4,"y":0},"fieldConfig":{"defaults":{"decimals":0},"overrides":[]},"targets":[{"expr":"round(sum(increase(itda_chat_requests_total[$__range])))","legendFormat":"질문"}]},
    {"type":"stat","title":"선택 기간 최종 성공률","id":3,"gridPos":{"h":4,"w":4,"x":8,"y":0},"fieldConfig":{"defaults":{"unit":"percent","decimals":1},"overrides":[]},"targets":[{"expr":"100 * sum(increase(itda_chat_requests_total{final_status=~\"first_attempt_success|recovered|accepted_empty\"}[$__range])) / clamp_min(sum(increase(itda_chat_requests_total[$__range])), 1)","legendFormat":"성공률"}]},
    {"type":"stat","title":"선택 기간 자기수정 성공","id":4,"gridPos":{"h":4,"w":4,"x":12,"y":0},"fieldConfig":{"defaults":{"decimals":0},"overrides":[]},"targets":[{"expr":"round(sum(increase(itda_repairs_total{outcome=\"success\"}[$__range])))","legendFormat":"복구"}]},
