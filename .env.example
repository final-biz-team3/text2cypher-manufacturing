# OpenAI
OPENAI_API_KEY=changeme
OPENAI_MODEL=changeme
# 비어 있으면 OPENAI_MODEL을 사용
ANSWER_MODEL=
ANSWER_MAX_ROWS=200
ANSWER_MAX_CHARS=8000
ANSWER_MAX_OUTPUT_TOKENS=1500
# Entity resolver의 similar lookup 운영값
ENTITY_SIMILARITY_THRESHOLD=0.3
ENTITY_CANDIDATE_LIMIT=5
# 비어 있으면 ANSWER_MODEL, 그다음 OPENAI_MODEL을 사용
FAILURE_ANSWER_MODEL=
FAILURE_ANSWER_MAX_OUTPUT_TOKENS=600

# Neo4j
NEO4J_USER=changeme
NEO4J_PASSWORD=changeme
NEO4J_URI=changeme
NEO4J_READER_USER=changeme
NEO4J_READER_PASSWORD=changeme
NEO4J_QUERY_TIMEOUT_SEC=changeme

# PostgreSQL
POSTGRES_HOST=changeme
POSTGRES_PORT=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
SQL_STATEMENT_TIMEOUT_MS=changeme
POSTGRES_POOL_MIN_SIZE=changeme
POSTGRES_POOL_MAX_SIZE=changeme
POSTGRES_WRITE_POOL_MIN_SIZE=changeme
POSTGRES_WRITE_POOL_MAX_SIZE=changeme

# 실행 결과 상한
SQL_ROW_LIMIT=changeme

# pgAdmin
PGADMIN_EMAIL=changeme
PGADMIN_PASSWORD=changeme

# Auth
JWT_SECRET_KEY=changeme

# App
APP_ENV=changeme
OBS_LOG_FAILED_QUERY=false
OBS_LOG_FAILED_QUERY_MAX_CHARS=4000
